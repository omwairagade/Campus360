generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int      @id @default(autoincrement())
  firstName          String
  lastName           String
  email              String   @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  mustChangePassword Boolean  @default(false)
  faculty            Faculty?
  student            Student?
}

model Student {
  id               Int                    @id @default(autoincrement())
  userId           Int                    @unique
  enrollmentNumber String                 @unique
  semester         Int
  admissionYear    Int
  phone            String?
  dateOfBirth      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  departmentId     Int
  programId        Int
  batch            String?
  division         String?
  submissions      AssignmentSubmission[]
  attendance       AttendanceRecord[]
  enrollments      CourseEnrollment[]
  results          ExamResult[]
  fees             Fee[]
  departmentRel    Department             @relation("StudentDepartment", fields: [departmentId], references: [id])
  programRel       Program                @relation("StudentProgram", fields: [programId], references: [id])
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([batch])
  @@index([division])
  @@index([semester])
  @@index([programId])
  @@index([departmentId])
}

model Faculty {
  id           Int              @id @default(autoincrement())
  userId       Int              @unique
  employeeId   String           @unique
  designation  String?
  departmentId Int
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignments  Assignment[]
  courses      Course[]
  exams        Exam[]
  department   Department       @relation(fields: [departmentId], references: [id])
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notices      Notice[]         @relation("FacultyCreatedNotices")
  timetable    TimetableEntry[]
}

model Department {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  code          String         @unique
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  courses       Course[]
  faculty       Faculty[]
  feeStructures FeeStructure[]
  programs      Program[]
  students      Student[]      @relation("StudentDepartment")
}

model Program {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  durationYears Int
  departmentId  Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  courses       Course[]
  feeStructures FeeStructure[]
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students      Student[]      @relation("StudentProgram")

  @@index([departmentId])
}

model AcademicYear {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  startYear     Int
  endYear       Int
  isActive      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  feeStructures FeeStructure[]

  @@index([startYear])
  @@index([endYear])
  @@index([isActive])
}

model FeeStructure {
  id             Int            @id @default(autoincrement())
  departmentId   Int
  programId      Int
  academicYearId Int
  semester       Int
  name           String
  description    String?
  totalAmount    Int            @default(0)
  dueDate        DateTime?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  fees           Fee[]
  components     FeeComponent[]
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  program        Program        @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, academicYearId, semester])
  @@index([departmentId])
  @@index([programId])
  @@index([academicYearId])
  @@index([semester])
  @@index([isActive])
}

model FeeComponent {
  id             Int          @id @default(autoincrement())
  feeStructureId Int
  name           String
  description    String?
  amount         Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
}

model Course {
  id            Int                @id @default(autoincrement())
  code          String             @unique
  name          String
  description   String?
  credits       Int
  semester      Int
  type          String
  departmentId  Int
  programId     Int
  facultyId     Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  assignments   Assignment[]
  attendance    AttendanceRecord[]
  department    Department         @relation(fields: [departmentId], references: [id])
  faculty       Faculty?           @relation(fields: [facultyId], references: [id])
  program       Program            @relation(fields: [programId], references: [id])
  enrollments   CourseEnrollment[]
  exams         Exam[]
  results       ExamResult[]
  noticeTargets Notice[]           @relation("NoticeTargetCourse")
  timetable     TimetableEntry[]
}

model CourseEnrollment {
  id              Int      @id @default(autoincrement())
  studentId       Int
  courseId        Int
  enrolledAt      DateTime @default(now())
  progressPercent Int      @default(0)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model AttendanceRecord {
  id        Int      @id @default(autoincrement())
  studentId Int
  courseId  Int
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, date])
}

model TimetableEntry {
  id        Int      @id @default(autoincrement())
  courseId  Int
  facultyId Int?
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  classType String   @default("Lecture")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  batch     String?
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty   Faculty? @relation(fields: [facultyId], references: [id])

  @@index([dayOfWeek])
  @@index([courseId])
  @@index([facultyId])
  @@index([batch])
}

model Assignment {
  id          Int                    @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime
  maxMarks    Int                    @default(100)
  courseId    Int
  facultyId   Int?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty     Faculty?               @relation(fields: [facultyId], references: [id])
  submissions AssignmentSubmission[]

  @@index([courseId])
  @@index([facultyId])
  @@index([dueDate])
}

model AssignmentSubmission {
  id            Int        @id @default(autoincrement())
  assignmentId  Int
  studentId     Int
  submittedAt   DateTime?
  status        String     @default("PENDING")
  marksObtained Int?
  remarks       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  fileName      String?
  fileSize      Int?
  fileType      String?
  fileUrl       String?
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
}

model Exam {
  id        Int          @id @default(autoincrement())
  title     String
  examType  String
  examDate  DateTime
  maxMarks  Int          @default(100)
  courseId  Int
  facultyId Int?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty   Faculty?     @relation(fields: [facultyId], references: [id])
  results   ExamResult[]

  @@index([courseId])
  @@index([facultyId])
  @@index([examDate])
}

model ExamResult {
  id            Int      @id @default(autoincrement())
  examId        Int
  studentId     Int
  courseId      Int
  marksObtained Float
  grade         String?
  gradePoint    Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([courseId])
}

model Fee {
  id             Int           @id @default(autoincrement())
  studentId      Int
  title          String
  totalAmount    Int
  paidAmount     Int           @default(0)
  dueDate        DateTime
  status         String        @default("PENDING")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  feeStructureId Int?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments       FeePayment[]

  @@index([studentId])
  @@index([feeStructureId])
  @@index([dueDate])
  @@index([status])
}

model FeePayment {
  id            Int      @id @default(autoincrement())
  feeId         Int
  amount        Int
  paymentDate   DateTime @default(now())
  paymentMethod String
  transactionId String   @unique
  createdAt     DateTime @default(now())
  fee           Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)

  @@index([feeId])
  @@index([paymentDate])
}

model Notice {
  id                 Int       @id @default(autoincrement())
  title              String
  message            String
  category           String    @default("GENERAL")
  priority           String    @default("NORMAL")
  isPublished        Boolean   @default(true)
  publishedAt        DateTime  @default(now())
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdByFacultyId Int?
  targetBatch        String?
  targetCourseId     Int?
  targetDivision     String?
  targetSemester     Int?
  createdBy          Faculty?  @relation("FacultyCreatedNotices", fields: [createdByFacultyId], references: [id])
  targetCourse       Course?   @relation("NoticeTargetCourse", fields: [targetCourseId], references: [id])

  @@index([category])
  @@index([priority])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([expiresAt])
  @@index([targetSemester])
  @@index([targetCourseId])
  @@index([targetBatch])
  @@index([targetDivision])
  @@index([createdByFacultyId])
}

model PaymentSetting {
  id            Int      @id @default(autoincrement())
  onlinePayment Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum UserRole {
  STUDENT
  FACULTY
  ADMIN
}
